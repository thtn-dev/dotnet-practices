{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          },
          {
            "PathPrefix": "/v1.0/invoke/auth-service/method"
          }
        ]
      },
      "worker-route": {
        "ClusterId": "worker-cluster",
        "Match": {
          "Path": "/worker/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/worker"
          },
          {
            "PathPrefix": "/v1.0/invoke/worker-service/method"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-dapr": {
            "Address": "http://127.0.0.1:3500"
          }
        }
      },
      "worker-cluster": {
        "Destinations": {
          "worker-dapr": {
            "Address": "http://127.0.0.1:3500"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
